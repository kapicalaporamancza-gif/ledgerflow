# ===== LedgerFlow MVP - env example =====
# Copy to .env and fill in. Real providers stay inactive until *_ENABLED=true.

# --- App ---
APP_ENV=dev
SECRET_KEY=change-me-in-prod

# --- DB ---
# For MVP / dev we use async SQLite. For prod swap to Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ledgerflow
DATABASE_URL=sqlite+aiosqlite:///./ledgerflow.db

# --- Storage ---
UPLOAD_DIR=./data/uploads

# --- AI provider ---
# Set AI_PROVIDER=openai and OPENAI_API_KEY=... to use real OpenAI.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Mail provider ---
# Set MAIL_PROVIDER=gmail with GOOGLE_* creds to enable real Gmail polling.
MAIL_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_POLL_INTERVAL_SECONDS=60
MAIL_WEBHOOK_SECRET=

# --- OCR ---
# Set OCR_PROVIDER=tesseract or OCR_PROVIDER=mistral to enable real OCR.
OCR_PROVIDER=mock
MISTRAL_API_KEY=
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr

# --- Business rules ---
REQUIRED_DOCS_COMPANY=invoice,bank_statement
REQUIRED_DOCS_SOLE_PROP=invoice,bank_statement,receipt