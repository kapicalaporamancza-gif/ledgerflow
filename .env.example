# Application
APP_ENV=dev
SECRET_KEY=change-me

# Database and local storage
DATABASE_URL=sqlite+aiosqlite:///./ledgerflow.db
# Paths may be absolute or relative to the LedgerFlow project directory.
UPLOAD_DIR=./data/uploads

# AI provider
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mail provider
MAIL_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Gmail search window for the "Pobierz maile" action.
GMAIL_LOOKBACK_DAYS=30
MAIL_POLL_INTERVAL_SECONDS=60
MAIL_WEBHOOK_SECRET=

# OCR provider
OCR_PROVIDER=mock
MISTRAL_API_KEY=
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr

# Business rules
REQUIRED_DOCS_COMPANY=invoice,bank_statement
REQUIRED_DOCS_SOLE_PROP=invoice,bank_statement,receipt
